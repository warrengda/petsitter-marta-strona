# petsitter.marta-olszewska.pl — statyczny build Astro (LiteSpeed, hostline.pl)
Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Jeden adres: https + petsitter.marta-olszewska.pl
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^petsitter\.marta-olszewska\.pl$ [NC]
RewriteRule ^ https://petsitter.marta-olszewska.pl%{REQUEST_URI} [R=301,L,NE]

# Adresy bez końcowego ukośnika → z ukośnikiem (gdy istnieje katalog ze stroną)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Panel Keystatic: wszystkie adresy /keystatic/... obsługuje jedna strona w przeglądarce
RewriteRule ^keystatic/.+ /keystatic/index.html [L]

ErrorDocument 404 /404.html

<FilesMatch "(^\.|\.(?:md|mdoc|log|bak|zip|json|yaml|yml)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # NA CZAS BUDOWY: usuń tę linię przy starcie strony (razem z INDEKSOWANIE = true w src/lib/dane.ts)
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Pliki z /_astro/ mają hash w nazwie — można je trzymać rok
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

AddDefaultCharset UTF-8
